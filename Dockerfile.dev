FROM golang:alpine

RUN apk --no-cache add gcc g++ make git npm p7zip
RUN /usr/local/go/bin/go install github.com/jessevdk/go-assets-builder@latest

WORKDIR /go/src/app

ENV GOMODCACHE=/go/pkg/mod
ENV GOCACHE=/root/.cache/go-build

EXPOSE 3030
EXPOSE 9600/tcp
EXPOSE 9600/udp
EXPOSE 8081

CMD ["sh", "-lc", "(test -d webapp/dist || (cd webapp && npm install && npm run build)) && (test -f src/assets.go || /go/bin/go-assets-builder schema.sql favicon.ico ini webapp/dist -o src/assets.go) && cd src && /usr/local/go/bin/go run . -debug -p /appdata"]
